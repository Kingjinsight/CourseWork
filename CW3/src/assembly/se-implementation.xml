<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.1"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.1
          https://maven.apache.org/xsd/assembly-2.1.1.xsd">
    <id>se-implementation</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>

    <fileSets>
        <fileSet>
            <directory>${project.basedir}</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>pom.xml</include>
            </includes>
        </fileSet>

        <fileSet>
            <directory>${project.basedir}/src/main/java</directory>
            <outputDirectory>/src/main/java</outputDirectory>
            <excludes>
                <exclude>uk/ac/ed/inf/eventsapp/facultypreregistration/**</exclude>
                <exclude>**/.DS_Store</exclude>
                <exclude>**/__MACOSX/**</exclude>
                <exclude>**/._*</exclude>
            </excludes>
        </fileSet>

        <fileSet>
            <directory>${project.basedir}/src/main/resources</directory>
            <outputDirectory>/src/main/resources</outputDirectory>
            <excludes>
                <exclude>**/.DS_Store</exclude>
                <exclude>**/__MACOSX/**</exclude>
                <exclude>**/._*</exclude>
            </excludes>
        </fileSet>

        <fileSet>
            <directory>${project.basedir}/src/test/java</directory>
            <outputDirectory>/src/test/java</outputDirectory>
            <excludes>
                <exclude>uk/ac/ed/inf/eventsapp/system/RegisterFacultyMemberSystemTests.java</exclude>
                <exclude>uk/ac/ed/inf/eventsapp/unit/TestFacultyMember.java</exclude>
                <exclude>uk/ac/ed/inf/eventsapp/unit/TestRegistrationUtility.java</exclude>
                <exclude>**/.DS_Store</exclude>
                <exclude>**/__MACOSX/**</exclude>
                <exclude>**/._*</exclude>
            </excludes>
        </fileSet>
    </fileSets>
</assembly>
